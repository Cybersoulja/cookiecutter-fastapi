SECRET_KEY=secret
DEBUG=True
MODEL_PATH={{cookiecutter.machine_learn_model_path}}
MODEL_NAME={{cookiecutter.machine_learn_model_name}}

# MCP Server Configuration (if enabled)
{% if cookiecutter.enable_mcp_server == 'yes' %}
MCP_SERVER_NAME={{cookiecutter.mcp_server_name}}
MCP_ENDPOINT={{cookiecutter.mcp_endpoint}}
MCP_API_KEY=change-this-to-a-secure-random-key
MCP_ALLOWED_ORIGINS=https://api.anthropic.com,https://claude.ai
LOG_LEVEL=INFO
{% endif %}